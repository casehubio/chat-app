{
  "name": "chat-app-ui",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "vite",
    "dev:esbuild": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "emoji-picker-element": "^1.29.1",
    "lit": "^3.3.3",
    "marked": "^15.0.12"
  },
  "optionalDependencies": {
    "@casehubio/mosaic-channel-activity": "file:.casehub-packages/packages/channel-activity",
    "@casehubio/mosaic-commitment-viz": "file:.casehub-packages/packages/commitment-viz",
    "@casehubio/mosaic-core": "file:.casehub-packages/packages/mosaic-core",
    "@casehubio/pages-component": "file:.casehub-packages/packages/pages-component",
    "@casehubio/pages-data": "file:.casehub-packages/packages/pages-data",
    "@casehubio/pages-primitives": "file:.casehub-packages/packages/pages-primitives",
    "@casehubio/pages-runtime": "file:.casehub-packages/packages/pages-runtime",
    "@casehubio/pages-table": "file:.casehub-packages/packages/pages-table",
    "@casehubio/pages-ui": "file:.casehub-packages/packages/pages-ui",
    "@casehubio/pages-ui-components": "file:.casehub-packages/packages/pages-ui-components",
    "@casehubio/pages-ui-tokens": "file:.casehub-packages/packages/pages-ui-tokens",
    "@casehubio/pages-viz": "file:.casehub-packages/packages/pages-viz"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
